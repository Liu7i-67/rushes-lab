# material-storage-api .env example
# 拷贝为 .env 并填实际值(.env 已 gitignore)

ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=console

# ─── Postgres(业务元数据 + audit;OpenFGA 共 instance 不同 db)──────
DB_URL=postgresql+asyncpg://msuser:mspass@localhost:5432/material_storage

# ─── Redis(arq queue + session cache)──────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO ────────────────────────────────
MINIO_ENDPOINT_INTERNAL=http://poc-pigsty-minio:9000
MINIO_ENDPOINT_PUBLIC=https://rusheslab.taoxiplan.com
MINIO_ACCESS_KEY=alice
MINIO_SECRET_KEY=alicesecret-poc-2026-32chars-pad
MINIO_DEFAULT_BUCKET=incoming

# ─── 缩略图分层(ADR-0008 P1:SSD 第二个 MinIO 专放缩略图)──
# 留空 = 回落主 MinIO(降级开关);生产 LAN 部署的完整模板见 .env.production.example
# MINIO_THUMBNAIL_ENDPOINT_INTERNAL=http://poc-minio-thumbs:9000
# MINIO_THUMBNAIL_ENDPOINT_PUBLIC=http://<内网host>   # 与 MINIO_ENDPOINT_PUBLIC 同 host(nginx 按 /ms-thumbs/ 路由)
# MINIO_THUMBNAIL_BUCKET=ms-thumbs                    # 降级 = 指回原片 bucket(如 ms-dev)

# ─── OpenFGA ──────────────────────────────
OPENFGA_API_URL=http://poc-openfga:8080
OPENFGA_STORE_ID=01KRR4FJN1S3RS112BZPN3ZXRH
# OPENFGA_MODEL_ID=...        # 可选;None = 用 store latest

# ─── 前端 base URL(Settings 必填项,缺了 ms-api 直接 ValidationError 起不来)──
# 通知链接 / 分享短链都基于它;本地 pnpm dev 走 http://localhost:5173/ms-static/web/
WEB_APP_BASE_URL=http://localhost:5173/ms-static/web/

# ─── 默认组织(新用户自动绑入;dev_bootstrap / grant_org_admin 也用它)──
# dev_bootstrap.py 固定用这个 UUID 建 dev-clinic org,本地照抄即可
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-0000000000a1

# ─── 可选 OIDC provider(#154:飞书下线,抽象为通用 provider 配置;默认空 = 纯本地登录)───
# OIDC_PROVIDER 是一个 JSON dict(见 app/settings.py 的 oidc_provider 字段):
#  {"authorize_endpoint": "...", "token_endpoint": "...", "userinfo_endpoint": "...",
#   "client_id": "...", "client_secret": "...", "scope": "...",
#   "claims": {"sub": "sub", "name": "name", "email": "email"}}
# 不设置 = 纯本地账号密码登录,以下字段均可省略:
# OIDC_PROVIDER={}

# ─── session JWT(iter5;openssl rand -hex 32 生成)───
SESSION_JWT_SECRET=replace-me-with-32-byte-random-hex-string
# SESSION_JWT_ALG=HS256
# SESSION_JWT_TTL_SECONDS=604800    # #149:默认 7 天(局域网使用,降频繁登录摩擦)
# SESSION_COOKIE_NAME=ms_session
# SESSION_COOKIE_SECURE=true       # dev 本地 http 时设 false
# SESSION_COOKIE_SAMESITE=lax

# ─── 本地账号密码登录(#149)───
# 登录限流:连续失败 AUTH_MAX_FAILURES 次锁 AUTH_LOCK_SECONDS 秒(per IP + per username)
# AUTH_MAX_FAILURES=5
# AUTH_LOCK_SECONDS=900
# 密码策略:最小长度(且必须含字母 + 数字)
# AUTH_PASSWORD_MIN_LENGTH=8

# ─── presigned URL TTL ────────────────────
PRESIGNED_NORMAL_TTL_SECONDS=900
PRESIGNED_SENSITIVE_TTL_SECONDS=600

# ─── audit ────────────────────────────────
AUDIT_RETENTION_DAYS=365

# ─── SMTP / 邮箱绑定-找回密码(邮箱账号方案 §5.10 / §9.2;全部注释 = 关闭)──────
# 两个独立开关(填了 SMTP 也不会自动打开任何一个):
#   EMAIL_AUTH_ENABLED  邮箱绑定/换绑/解绑 + 找回密码 总开关(生效还需 SMTP 齐备,
#                       合成 mail_ready = EMAIL_AUTH_ENABLED && smtp_enabled;
#                       配置不合法时降级 mail_ready=false 入口隐藏,不拖垮登录)
#   NOTIFY_EMAIL_ENABLED 站内通知邮件(审批/邀请)独立开关,默认 false;开启前
#                        由产品确认收件地址可信(建议只发已验证邮箱)
# EMAIL_LINK_BASE_URL:邮件链接基址(忘记密码/重置页 SPA)。
#   ⚠ 功能开启时必填;**不回落 WEB_APP_BASE_URL**(生产 WEB_APP_BASE_URL 是内网
#     地址,回落会让邮件链接在 4G 下打不开);生产必须公网 https 且以
#     /ms-static/web/ 结尾(校验不过 → mail_ready=false + ERROR 日志)。
# EMAIL_LINK_BASE_URL_LAN:可选内网基址;配置后邮件正文同时给内网链接(双入口兜底,
#   允许私网 host);它不能单独让 mail_ready 变 true。
# 端口/TLS 口径(校验互斥):465 → SMTP_USE_SSL=true + SMTP_USE_TLS=false;
#                            587 → SMTP_USE_TLS=true + SMTP_USE_SSL=false。
# SMTP_FROM_EMAIL 只填纯地址(如 noreply@example.com);显示名走 SMTP_FROM_NAME,
#   不要把 "Name <addr>" 塞进 SMTP_FROM_EMAIL(启动校验会拒绝)。
# 改本段后必须 docker compose up -d --force-recreate ms-api ms-worker
#   (restart 不重读 env_file);上线顺序见 ops-manual §13。
# EMAIL_AUTH_ENABLED=false
# NOTIFY_EMAIL_ENABLED=false
# EMAIL_LINK_BASE_URL=https://bucket.taoxiplan.com/ms-static/web/
# EMAIL_LINK_BASE_URL_LAN=http://192.168.110.221:8090/ms-static/web/   # dev/内网兜底
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=***
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=素材库
# ── 频控/有效期(默认值,可调;方案 §5.10 全表)──
# SMTP_TIMEOUT_SECONDS=15          # 单次 socket 操作超时
# SMTP_TOTAL_TIMEOUT_SECONDS=20    # 交互式发信总预算(< 前端 30s)
# EMAIL_CODE_TTL_SECONDS=600       # 验证码有效期
# EMAIL_CODE_RESEND_SECONDS=60     # 重发冷却
# EMAIL_CODE_DAILY_PER_USER=10     # 每用户每日验证码上限
# PASSWORD_RESET_TOKEN_TTL_SECONDS=1800   # 重置链接有效期
# PASSWORD_RESET_MAX_FAILURES=5    # R8:IP 失败上限(连续失败 N 次锁 IP)
# PASSWORD_RESET_LOCK_SECONDS=900  # R8:IP 封控时长
