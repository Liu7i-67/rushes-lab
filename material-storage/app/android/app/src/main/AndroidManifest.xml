<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- photo_manager:相册读(Android 13+ 细分媒体权限 + 旧版兜底) -->
    <!-- ⚠ Flutter 模板只在 debug/profile 清单给 INTERNET;release 包必须在主清单声明,
         否则安装后一切网络请求(host lookup)全挂 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <!-- B0② media_store_plus:API<29 写 Downloads 需要旧版写权限(API 30+ 走
         MediaStore 免权限);minSdk 跟随 Flutter 默认,真机确认基线前先声明 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <!-- mobile-ux-polish P8 flutter_local_notifications:Android 13+ 传输完成
         系统通知需要通知权限(运行时弹窗由 Notifier.ensurePermission 首次入队
         时发起,不在 app 启动即弹) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- mobile-ux-polish-2 R2:相册音频申明 —— photo_manager RequestType.all
         含 audio,picker 内部权限请求在 Android 13 整机要求 READ_MEDIA_AUDIO,
         未申明会被系统直接 DENY → 整体判 Denied →「相册选择失败」;
         READ_MEDIA_VISUAL_USER_SELECTED:Android 14+ limited(部分照片)授权态 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <!-- mobile-ux-polish-2 R4d:传输前台服务保活(flutter_foreground_task,
         dataSync 类型;Android 14+ 起必须申明 type 级权限,服务才能 startForeground) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <application
        android:label="浣花视界"
        android:name="${applicationName}"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher">
        <!-- ↑ 对齐 iOS NSAllowsArbitraryLoads:dev/内网入口是裸 IP 直连 http,
             Android 9+ 默认禁明文且 networkSecurityConfig 不认 IP 字面量,必须全局放开 -->
        <!-- ↑ requestLegacyExternalStorage:media_store_plus 文档要求(API 29
             Scoped Storage 兼容,仅影响 Android 10;31+ 系统忽略此标志) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- mobile-ux-polish-2 R4d flutter_foreground_task:传输前台服务
             (dataSync 类型,Android 14+ 必须显式 foregroundServiceType;
             stopWithTask 在 ForegroundTaskOptions 运行时置 true——滑掉任务即停,
             不留常驻;类名不可改,插件按此解析) -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- R4d:服务常驻通知的小图标(meta-data 名与
             transfer_foreground.dart 的 kForegroundIconMetaData 一致;
             复用 P8 的单色 drawable,通知栏小图标只认 drawable 资源) -->
        <meta-data
            android:name="ms_transfer_fg_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- B0① url_launcher:Android 11+ 包可见性过滤,声明 ACTION_VIEW https
             才能解析到可打开百度授权链接的浏览器(launchUrl externalApplication) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
